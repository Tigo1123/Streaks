PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional PEM CA certificate content; otherwise server/certs/supabase-ca.crt or Node's default CA store is used.
# DATABASE_CA_CERT=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500
NODE_ENV=development

# For integration tests, point this at a separate database whose name includes
# "test" (for example: postgresql://USER:PASSWORD@localhost:5432/streaks_test).
TEST_DATABASE_URL=
